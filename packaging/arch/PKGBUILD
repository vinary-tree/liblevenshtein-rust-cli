# Maintainer: F1R3FLY.io <noreply@f1r3fly.io>
# NOTE: This PKGBUILD is for tagged releases
pkgname=liblevenshtein
pkgver=0.10.0
pkgrel=1
pkgdesc="Fuzzy matching, dictionary, REPL, and document grep utility"
arch=('x86_64' 'aarch64')
url="https://github.com/vinary-tree/liblevenshtein-rust-cli"
license=('Apache')
depends=('gcc-libs')
makedepends=('rust' 'cargo' 'protobuf')
source=("liblevenshtein-cli::git+https://github.com/vinary-tree/liblevenshtein-rust-cli.git#tag=v${pkgver}")
sha256sums=('SKIP')

prepare() {
    cd "$srcdir/liblevenshtein-cli"
    sed -i -E 's/path = "\.\.\/(liblevenshtein-rust|libdictenstein)", //g' Cargo.toml
    cargo generate-lockfile
}

build() {
    cd "$srcdir/liblevenshtein-cli"
    export CARGO_TARGET_DIR=target

    # Determine RUSTFLAGS based on architecture
    if [ "$CARCH" = "x86_64" ]; then
        export RUSTFLAGS="-C target-feature=+aes,+sse2"
    elif [ "$CARCH" = "aarch64" ]; then
        export RUSTFLAGS="-C target-feature=+aes,+neon"
    fi

    cargo build --release --locked
}

check() {
    cd "$srcdir/liblevenshtein-cli"

    # Determine RUSTFLAGS based on architecture
    if [ "$CARCH" = "x86_64" ]; then
        export RUSTFLAGS="-C target-feature=+aes,+sse2"
    elif [ "$CARCH" = "aarch64" ]; then
        export RUSTFLAGS="-C target-feature=+aes,+neon"
    fi

    cargo test --release --locked
}

package() {
    cd "$srcdir/liblevenshtein-cli"

    # Install binary
    install -Dm755 "target/release/liblevenshtein" "$pkgdir/usr/bin/liblevenshtein"

    # Install license and documentation
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
    install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
    install -Dm644 CHANGELOG.md "$pkgdir/usr/share/doc/$pkgname/CHANGELOG.md"

}
